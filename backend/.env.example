# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Firebase Configuration
FIREBASE_PROJECT_ID=expense-tracker-c431a
FIREBASE_DATABASE_URL=https://expense-tracker-c431a-default-rtdb.asia-southeast1.firebasedatabase.app

# Path to Firebase Service Account JSON (Recommended for local dev)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Fallback mode (true = mock in-memory, false = live database)
MOCK_FIREBASE=false
